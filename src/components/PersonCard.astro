---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Person } from '../data/people';
import { fields } from '../data/people';
interface Props { person: Person }
const { person } = Astro.props;
const portraits = import.meta.glob<ImageMetadata>('../../static/images/team/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' });
const portrait = person.portrait ? portraits['../../static' + person.portrait] : undefined;
if (person.portrait && !portrait) throw new Error(`Missing portrait for ${person.id}`);
---
<article class="person-directory-card" id={person.id} data-person-id={person.id}>
  <div class="directory-portrait">{portrait ? <><Image src={portrait} widths={[320,640,960]} sizes="(max-width: 760px) 100vw, 40vw" format="webp" loading="lazy" alt={`${person.name} 的人物肖像；${person.portraitNote}`} /><p>{person.portraitNote}</p></> : <div class="directory-portrait-placeholder" role="img" aria-label={`${person.name} 的姓名占位图`}><span aria-hidden="true">{person.name}</span><p>人物肖像待补充</p></div>}</div>
  <div class="directory-person-body"><span class="profile-handle">{person.handle}</span><h3>{person.name}</h3><p class="directory-role">{person.role}</p>{person.quote && <blockquote>“{person.quote}”</blockquote>}<ul class="directory-field-tags" aria-label="专业领域">{person.fields.map(id=><li>{fields.find(field=>field.id===id)?.label}</li>)}</ul><p class="directory-description">{person.description}</p><div class="profile-tags">{person.tags.map(tag=><span>{tag}</span>)}</div>
    {(person.principles.length > 0 || person.projects.length > 0) && <details class="person-more"><summary>走近 {person.name}<span aria-hidden="true"> ＋</span></summary><div class="person-more-content"><div class="profile-principles">{person.principles.map((item,i)=><div><span>0{i+1}</span><div><h4>{item.title}</h4><p>{item.text}</p></div></div>)}</div>{person.projects.length > 0 && <h4>作品与探索</h4>}<ul class="person-projects">{person.projects.map(project=><li><a href={project.href} target="_blank" rel="noopener noreferrer">{project.title} ↗</a><p>{project.summary}</p></li>)}</ul></div></details>}
    <a class="people-text-link" href={'mailto:info@airdb.com?subject='+encodeURIComponent('认识 '+person.name+' — AIRDB Team')}>和 {person.name} 聊聊 ↗</a>
  </div>
</article>
